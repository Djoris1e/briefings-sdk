# Copy to .dev.vars. Keep keys server-side; never use VITE_ variables for them.
# Start with real AI planning; AI footage is optional.
# wrangler.jsonc already enables fal; no extra local flag is needed.
ANTHROPIC_API_KEY=
FAL_KEY=

# Optional generated voice. Without it, playback has no narration.
XAI_API_KEY=

# Stock footage used alongside templates and optional AI footage.
PEXELS_API_KEY=

# npm run dev supplies a persistent local-only quota salt and local D1 database.
# Production deployment keeps its own existing salt, database and access rules.

# Models, voices and optional screenshot animation: briefing.config.ts.
# Optional server environment overrides:
# BRIEFING_PLANNER_MODEL=claude-haiku-4-5
# BRIEFING_NARRATOR_VOICE=eve
# BRIEFING_HOST_VOICE=eve
# BRIEFING_ANALYST_VOICE=leo
# BRIEFING_LANGUAGE=auto
# BRIEFING_ANIMATE_SCREENSHOTS=false
